# 大模型（OpenAI 兼容）
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
OPENAI_MODEL=qwen3.8-max

# 向量库（Zilliz / Milvus）
MILVUS_URI=https://your-zilliz-endpoint
MILVUS_TOKEN=your-token
MILVUS_COLLECTION=rag_data_new
EMBED_DIM=512

# Kafka
KAFKA_BOOTSTRAP=localhost:9092
KAFKA_TOPIC=rag-parse
KAFKA_GROUP=rag-parse-worker
KAFKA_ENABLED=true

# MinerU：flash 不需要本地 parse-server；standard 需要先启用
MINERU_TIER=flash

# 路径（默认 backend/data、backend/models）
# DATA_DIR=
# MODELS_DIR=

# 业务参数
TOP_K=6
CHUNK_SIZE=300
TEXT_MAX_BYTES=1000
MAX_UPLOAD_MB=50
CHAT_INCLUDE_RETRIEVED_IMAGES=true
MAX_INLINE_IMAGES=2
