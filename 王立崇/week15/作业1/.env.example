# 复制为 .env 后填写。全部留空也能运行：
# 进程1 会退化为词典情感识别，进程2 会退化为模板回复。

# ---- OpenAI 官方 ----
# OPENAI_API_KEY=sk-xxxx
# OPENAI_MODEL=gpt-4o-mini

# ---- DeepSeek（只填 DEEPSEEK_API_KEY 即可，地址和模型会自动补全）----
# DEEPSEEK_API_KEY=sk-xxxx

# ---- 其他 OpenAI 兼容服务（Qwen / Moonshot / 本地 vLLM 等）----
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# 单次请求超时（秒）
# LLM_TIMEOUT=60

# ---- 可选：本地微调情感模型（进程1 优先使用，需安装 requirements.model.txt）----
# SENTIMENT_MODEL_PATH=/models/my-sentiment
# SENTIMENT_DEVICE=-1
# SENTIMENT_LABEL_MAP={"LABEL_0": "negative", "LABEL_1": "positive"}

# ---- 可选：WebSocket 流式下发节奏 ----
# WS_CHUNK_SIZE=4
# WS_CHUNK_DELAY=0.02
