# 方式一（推荐）：LLM_* 命名
LLM_API_KEY=sk-xxxx
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4/   # 智谱 GLM / DeepSeek 等兼容端点
LLM_MODEL=glm-5.3-flash                              # 与 BASE_URL 匹配的模型名

# 方式二：OpenAI 兼容命名（与方式二选一即可，LLM_* 优先）
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://api.openai.com/v1
# MODEL_NAME=gpt-4o-mini

PIPELINE_ENGINE=langgraph                            # langgraph | openai-agents
PORT=8000
