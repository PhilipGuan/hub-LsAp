# Runtime
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5180

# Vision provider: demo | openai | qwen
# demo: 不需要任何 Key，用于离线跑通全链
VISION_PROVIDER=demo

# OpenAI-compatible multimodal endpoint
LLM_API_KEY=
LLM_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-vl-plus

# Qwen native DashScope SDK (reserved)
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope-intl.aliyuncs.com/api/v1
QWEN_MODEL=qwen3-vl-plus

REQUEST_TIMEOUT_SECONDS=60

# USDA FoodData Central（仅离线摄入脚本 scripts/ingest_usda.py 使用，运行时不读）
# 免费申请：https://fdc.nal.usda.gov/api-key-signup.html
USDA_API_KEY=
