# ============================================================
# envify-llm 规范：三键位（provider + API_KEY + BASE_URL + MODEL）
# 推荐把真实值写到：../../Week08/.env （级联查找优先，避免 commit 真实 Key）
# 本文件只留占位符，上传 GitHub 没问题。
# ============================================================

# ===== LLM Provider（必选其一）=====
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# LLM_PROVIDER=qwen
# QWEN_API_KEY=your_qwen_key_here
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# QWEN_MODEL=qwen-plus

# LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-xxx-your-real-key
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# ===== LLM 行为 =====
LLM_TEMPERATURE=0.7
RESEARCH_MAX_ROUNDS=3

# ===== Bocha 搜索 API（可选；不填就走纯 Provider 数据 degrade） =====
BOCHA_API_KEY=your_bocha_key_here
BOCHA_BASE_URL=https://api.bochaai.com/v1

# ===== 前端 CORS（FastAPI 模式下用） =====
FRONTEND_ORIGIN=*

# ===== 可选付费 Provider Key（留空自动不加载） =====
# POLYGON_API_KEY=your_polygon_key_here
# ALPHA_VANTAGE_API_KEY=your_av_key_here
