# —— 复制为 .env 后填入真实值 ——
# 注意：本目录【不】存放真实密钥。sqlagent/config.py 的查找顺序是：
#   1) 当前目录及各级父目录中的 .env（即仓库根目录 /Users/.../padow-ai/.env）
#   2) 系统环境变量
# 因此通常无需在本目录新建 .env，直接复用仓库根目录那份即可。

# 选择默认使用的模型：deepseek 或 qwen
LLM_PROVIDER=deepseek

# DeepSeek（OpenAI 兼容端点，本项目默认）
DEEPSEEK_API_KEY=sk-你的_DEEPSEEK_API_KEY
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash

# Qwen（阿里云 DashScope 兼容模式，可选）
QWEN_API_KEY=你的_Qwen_API_KEY
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# 可选：覆盖默认数据库定位（默认在项目内逐级向上查找 chinook.db）
# DB_URL=sqlite:////absolute/path/to/your.db
#
# 上线建议（D13）：用 SQLite 只读 URI 打开，把「只读」从代码约定升级为数据库强制。
# 之后 sqlagent/guard.py 的 is_readonly() 从「安全边界」降级为「早退优化」，双保险。
# 注意三斜杠 + file: + ?mode=ro&uri=true 的写法（相对路径）与四斜杠（绝对路径）之别。
# DB_URL=sqlite:///file:/app/data/chinook.db?mode=ro&uri=true

# —— 上线准入与状态（批 3 / D8 / D10 / D11）——

# 共享访问口令（D10）：作品集链接会漂到全网，口令让你能把链接只发给受邀的人。
# 留空 = 不校验（仅本地开发）；上线必填。校验通过后下发 httpOnly cookie，前端不再重复提交。
APP_PASSCODE=

# 状态文件（D8）：检查点 + 会话元数据 + 配额 + 审计共用一个 SQLite 文件（同库不同表）。
# 相对路径按进程的工作目录解析；容器里建议指到读写挂卷上（见 Dockerfile 批 4）。
# STATE_DB_PATH=checkpoints.sqlite

# 配额与会话保留期是代码里的常量（server/store.py），不在这里配：
#   每日全局 200 轮 / 单会话 20 轮 / 会话 7 天未访问即清理（D8 / D11）

# —— 可选：模型兜底（主模型重试仍失败时自动切到备用）——
# 两种配法二选一，LLM_FALLBACK_PROVIDER 优先：
#   1) 跨 provider 兜底（应对主 provider 整体不可用）：
# LLM_FALLBACK_PROVIDER=qwen
#   2) 同 provider 换模型（应对单模型限流 / 过载）：
# LLM_FALLBACK_MODEL=deepseek-chat
# 不配即不启用（行为与未加兜底时逐字一致）。
