DATA_DIR=./data
REDIS_URL=redis://localhost:6379/0
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=week14.pdf.parse
KAFKA_GROUP=week14-mineru
# OpenAI-compatible vision endpoint. Set these three values before asking questions.
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=
LLM_MODEL=qwen-vl-plus
# Course image uses MinerU 2.x/3.x CLI. Select modern for MinerU 4.x.
MINERU_CLI_STYLE=legacy
MINERU_BACKEND=pipeline
MINERU_SERVER_URL=
MINERU_TIMEOUT=1200
MINERU_MODEL_SOURCE=modelscope
